    {
      "name": "core.vw_multas_pendientes",
      "type": "VIEW",
      "comment": "Total de multas sin pagar por socio",
      "columns": [
        {
          "name": "socio_id",
          "type": "integer",
          "nullable": true
        },
        {
          "name": "nombre",
          "type": "varchar(100)",
          "nullable": true
        },
        {
          "name": "total_pendiente",
          "type": "numeric",
          "nullable": true
        }
      ],
      "def": "CREATE VIEW vw_multas_pendientes AS (\n SELECT s.socio_id,\n    s.nombre,\n    sum(m.monto) AS total_pendiente\n   FROM ((core.multas m\n     JOIN core.prestamos p ON ((p.prestamo_id = m.prestamo_id)))\n     JOIN core.socios s ON ((s.socio_id = p.socio_id)))\n  WHERE (NOT m.pagada)\n  GROUP BY s.socio_id, s.nombre\n)",
      "referenced_tables": [
        "core.multas",
        "core.prestamos",
        "core.socios"
      ]
    }
